# JewelTry Production Environment Variables Template

# App Settings
APP_NAME="JewelTry Backend"
APP_ENV="production"
DEBUG=false
CORS_ORIGINS=["*"]
ADMIN_SECRET_KEY="replace-with-your-secure-admin-secret"

# Supabase Credentials (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Gemini AI API Key & Model Configuration
GEMINI_API_KEY="your-gemini-api-key"
AI_PROVIDER="gemini"
AI_MODEL="gemini-2.5-flash"
AI_OUTPUT_SIZE="1K"
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=60

# Android Google Play Billing Verification
GOOGLE_PLAY_PACKAGE_NAME="com.jeweltry.app"
GOOGLE_APPLICATION_CREDENTIALS="/etc/secrets/google-service-account.json"

# Limits & Upload Constraints
MAX_UPLOAD_MB=10
